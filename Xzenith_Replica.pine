// Xzenith Replica - Session-based swing range indicator
// Identifies a trading session range (High/Low), then plots:
//   - Entry Level: exact entry price (midpoint of Golden Window zone)
//   - Invalidation Level: stop loss beyond the extreme
//   - Target Interest 1, 2, 3: profit targets projected from the range
//
// Direction: close below midpoint → LONG, above → SHORT
// Levels develop in real-time during the session and finalize at session close.

//@version=6
indicator("Xzenith Replica", overlay=true,
     max_lines_count=500, max_labels_count=500)

// ============================================================================
// SESSION INPUTS
// ============================================================================

sessionType = input.string("Asian", "Session", options=["Asian", "London", "New York", "Custom"],
     group="Session",
     tooltip="Which session to use for range detection.")

customStart = input.session("0000-0800", "Custom Session Time (Exchange TZ)",
     group="Session",
     tooltip="Only used when Session = Custom. Format: HHMM-HHMM in exchange timezone.")

sessionTZ = input.string("America/New_York", "Exchange Timezone",
     options=["America/New_York", "Europe/London", "Asia/Tokyo", "Asia/Hong_Kong",
              "Australia/Sydney", "UTC"],
     group="Session")

showSessionBG = input.bool(true, "Show Session Background", group="Session")
sessionBGColor = input.color(color.new(color.blue, 90), "Session Background Color", group="Session")

// ============================================================================
// RANGE & TARGET INPUTS
// ============================================================================

pivotLookback = input.int(10, "Swing Detection Lookback", minval=3, maxval=50,
     group="Range Detection",
     tooltip="Bars to look back for confirming swing highs/lows within the session.")

gwAbove = input.float(0.236, "GW Above Extreme (Fib)", minval=0, maxval=1.0, step=0.01,
     group="Golden Window",
     tooltip="Golden Window extends this far above the Low (for longs) or below the High (for shorts), as a ratio of the range.")
gwBelow = input.float(0.272, "GW Below Extreme (Fib)", minval=0, maxval=1.0, step=0.01,
     group="Golden Window",
     tooltip="Golden Window extends this far below the Low (for longs) or above the High (for shorts), as a ratio of the range.")

invalidationFib = input.float(0.414, "Invalidation Distance (Fib)", minval=0.05, maxval=2.0, step=0.01,
     group="Levels",
     tooltip="Distance beyond the swing extreme for the Invalidation Level, as a ratio of the range.")

// ============================================================================
// RANGE FILTER INPUTS
// ============================================================================

minRangeATR = input.float(0.0, "Min Range (x ATR)", minval=0, maxval=10, step=0.1,
     group="Range Filter",
     tooltip="Session range must be at least this many times the ATR to generate a setup. Set to 0 to disable.")
maxRangeATR = input.float(0.0, "Max Range (x ATR)", minval=0, maxval=20, step=0.5,
     group="Range Filter",
     tooltip="Session range must be smaller than this many times the ATR. Set to 0 to disable.")
filterATRPeriod = input.int(14, "Filter ATR Period", minval=1, maxval=100,
     group="Range Filter")
maxSetupsPerDay = input.int(5, "Max Setups Per Day", minval=1, maxval=5,
     group="Range Filter",
     tooltip="Maximum number of setups to show per day.")

targetStart = input.float(0.786, "Target Start (Fib from extreme)", minval=0.1, maxval=3.0, step=0.01,
     group="Targets",
     tooltip="First target is placed at this Fibonacci level of the range, measured from the entry extreme.")
targetSpacing = input.float(0.618, "Target Spacing (Fib)", minval=0.1, maxval=3.0, step=0.01,
     group="Targets",
     tooltip="Distance between each target, as a ratio of the range.")

// ============================================================================
// DISPLAY INPUTS
// ============================================================================

showHighLow    = input.bool(true, "Show High/Low Labels", group="Display")
showEntry      = input.bool(true, "Show Entry Level", group="Display")
showInvalid    = input.bool(true, "Show Invalidation Level", group="Display")
showTargets    = input.bool(true, "Show Target Interest Lines", group="Display")

entryColor     = input.color(color.new(#d4a017, 0), "Entry Level Color", group="Colors")
invalidColor   = input.color(color.new(color.red, 20), "Invalidation Level Color", group="Colors")
targetColor    = input.color(color.new(color.green, 20), "Target Lines Color", group="Colors")
highLowColor   = input.color(color.new(color.blue, 20), "High/Low Lines Color", group="Colors")

// ============================================================================
// SESSION TIME CALCULATION
// ============================================================================

sessionStr = switch sessionType
    "Asian"    => "0000-0800"
    "London"   => "0800-1200"
    "New York" => "1200-1700"
    "Custom"   => customStart

inSession = not na(time(timeframe.period, sessionStr, sessionTZ))
wasInSession = not na(time(timeframe.period, sessionStr, sessionTZ))[1]

sessionStart = inSession and not wasInSession
sessionEnd   = not inSession and wasInSession

bgcolor(showSessionBG and inSession ? sessionBGColor : na, title="Session Background")

// ============================================================================
// FILTER ATR CALCULATION
// ============================================================================

filterATR = ta.atr(filterATRPeriod)

// ============================================================================
// SESSION RANGE TRACKING
// ============================================================================

var float sessionHigh    = na
var float sessionLow     = na
var int   sessionStartBar = na
var int   setupsToday    = 0

if sessionStart
    sessionHigh    := high
    sessionLow     := low
    sessionStartBar := bar_index
    setupsToday    := 0

if inSession
    sessionHigh := math.max(nz(sessionHigh, high), high)
    sessionLow  := math.min(nz(sessionLow, low), low)

// ============================================================================
// LIVE DEVELOPING LEVELS (updated every bar during session)
// ============================================================================

var line liveHighLine    = na
var line liveLowLine     = na
var line liveEntryLine   = na
var line liveInvalidLine = na
var line liveTgt1Line    = na
var line liveTgt2Line    = na
var line liveTgt3Line    = na

var label liveHighLabel    = na
var label liveLowLabel     = na
var label liveEntryLabel   = na
var label liveInvalidLabel = na
var label liveTgt1Label    = na
var label liveTgt2Label    = na
var label liveTgt3Label    = na

var bool  liveIsLong     = false
var bool  liveActive     = false

lineExtend = 80

if sessionStart
    liveActive := true

    // Create new drawing objects for this session
    if showHighLow
        liveHighLine := line.new(bar_index, high, bar_index + lineExtend, high,
             color=highLowColor, width=1, style=line.style_solid)
        liveLowLine := line.new(bar_index, low, bar_index + lineExtend, low,
             color=highLowColor, width=1, style=line.style_solid)
        liveHighLabel := label.new(bar_index, high, "High: " + str.tostring(high, format.mintick),
             style=label.style_label_down, color=color.new(color.gray, 40),
             textcolor=color.white, size=size.normal)
        liveLowLabel := label.new(bar_index, low, "Low: " + str.tostring(low, format.mintick),
             style=label.style_label_up, color=color.new(color.gray, 40),
             textcolor=color.white, size=size.normal)

    if showEntry
        liveEntryLine := line.new(bar_index, close, bar_index + lineExtend, close,
             color=entryColor, width=2, style=line.style_dashed)
        liveEntryLabel := label.new(bar_index + 20, close,
             "ENTRY " + str.tostring(close, format.mintick),
             style=label.style_label_down, color=entryColor,
             textcolor=color.white, size=size.small)

    if showInvalid
        liveInvalidLine := line.new(bar_index, close, bar_index + lineExtend, close,
             color=invalidColor, width=2, style=line.style_solid)
        liveInvalidLabel := label.new(bar_index + 20, close, "INVALIDATION LEVEL",
             style=label.style_label_down, color=invalidColor,
             textcolor=color.white, size=size.small)

    if showTargets
        liveTgt1Line := line.new(bar_index, close, bar_index + lineExtend, close,
             color=targetColor, width=1, style=line.style_solid)
        liveTgt1Label := label.new(bar_index + 20, close, "TARGET INTEREST 1",
             style=label.style_label_down, color=targetColor,
             textcolor=color.white, size=size.small)
        liveTgt2Line := line.new(bar_index, close, bar_index + lineExtend, close,
             color=targetColor, width=1, style=line.style_solid)
        liveTgt2Label := label.new(bar_index + 20, close, "TARGET INTEREST 2",
             style=label.style_label_down, color=targetColor,
             textcolor=color.white, size=size.small)
        liveTgt3Line := line.new(bar_index, close, bar_index + lineExtend, close,
             color=targetColor, width=1, style=line.style_solid)
        liveTgt3Label := label.new(bar_index + 20, close, "TARGET INTEREST 3",
             style=label.style_label_down, color=targetColor,
             textcolor=color.white, size=size.small)

// Update levels every bar during session
if inSession and liveActive
    float rangeSize = sessionHigh - sessionLow
    float rangeMid  = (sessionHigh + sessionLow) / 2

    // Live direction: use current close vs midpoint
    liveIsLong := close < rangeMid

    float liveEntry = na
    float liveInvalid = na
    float liveTgt1 = na
    float liveTgt2 = na
    float liveTgt3 = na

    if rangeSize > 0
        if liveIsLong
            liveEntry   := sessionLow + rangeSize * (gwAbove - gwBelow) / 2
            liveInvalid := sessionLow - rangeSize * invalidationFib
            liveTgt1    := sessionLow + rangeSize * targetStart
            liveTgt2    := sessionLow + rangeSize * (targetStart + targetSpacing)
            liveTgt3    := sessionLow + rangeSize * (targetStart + targetSpacing * 2)
        else
            float avgGW = (gwAbove + gwBelow) / 2
            float ref   = sessionHigh + rangeSize * targetSpacing
            liveInvalid := ref + rangeSize * gwAbove
            liveEntry   := liveInvalid - rangeSize * avgGW
            liveTgt1    := liveInvalid - rangeSize * avgGW * 2
            liveTgt2    := liveInvalid - rangeSize * avgGW * 3
            liveTgt3    := liveInvalid - rangeSize * avgGW * 4

        // Update High/Low lines and labels
        if showHighLow and not na(liveHighLine)
            line.set_y1(liveHighLine, sessionHigh)
            line.set_y2(liveHighLine, sessionHigh)
            line.set_x2(liveHighLine, bar_index + lineExtend)
            line.set_y1(liveLowLine, sessionLow)
            line.set_y2(liveLowLine, sessionLow)
            line.set_x2(liveLowLine, bar_index + lineExtend)
            label.set_y(liveHighLabel, sessionHigh)
            label.set_text(liveHighLabel, "High: " + str.tostring(sessionHigh, format.mintick))
            label.set_y(liveLowLabel, sessionLow)
            label.set_text(liveLowLabel, "Low: " + str.tostring(sessionLow, format.mintick))

        // Update Entry line
        if showEntry and not na(liveEntryLine)
            line.set_y1(liveEntryLine, liveEntry)
            line.set_y2(liveEntryLine, liveEntry)
            line.set_x2(liveEntryLine, bar_index + lineExtend)
            label.set_y(liveEntryLabel, liveEntry)
            label.set_x(liveEntryLabel, bar_index + 20)
            label.set_text(liveEntryLabel, "ENTRY " + str.tostring(liveEntry, format.mintick))

        // Update Invalidation line
        if showInvalid and not na(liveInvalidLine)
            line.set_y1(liveInvalidLine, liveInvalid)
            line.set_y2(liveInvalidLine, liveInvalid)
            line.set_x2(liveInvalidLine, bar_index + lineExtend)
            label.set_y(liveInvalidLabel, liveInvalid)
            label.set_x(liveInvalidLabel, bar_index + 20)

        // Update Target lines
        if showTargets and not na(liveTgt1Line)
            line.set_y1(liveTgt1Line, liveTgt1)
            line.set_y2(liveTgt1Line, liveTgt1)
            line.set_x2(liveTgt1Line, bar_index + lineExtend)
            label.set_y(liveTgt1Label, liveTgt1)
            label.set_x(liveTgt1Label, bar_index + 20)

            line.set_y1(liveTgt2Line, liveTgt2)
            line.set_y2(liveTgt2Line, liveTgt2)
            line.set_x2(liveTgt2Line, bar_index + lineExtend)
            label.set_y(liveTgt2Label, liveTgt2)
            label.set_x(liveTgt2Label, bar_index + 20)

            line.set_y1(liveTgt3Line, liveTgt3)
            line.set_y2(liveTgt3Line, liveTgt3)
            line.set_x2(liveTgt3Line, bar_index + lineExtend)
            label.set_y(liveTgt3Label, liveTgt3)
            label.set_x(liveTgt3Label, bar_index + 20)

// ============================================================================
// SESSION END: Finalize direction and lock levels
// ============================================================================

var float setupHigh   = na
var float setupLow    = na
var bool  setupIsLong = false
var bool  newSetup    = false

newSetup := false

if sessionEnd
    float rangeSize = sessionHigh - sessionLow
    float rangeMid  = (sessionHigh + sessionLow) / 2

    bool minOK = minRangeATR == 0 or rangeSize >= filterATR * minRangeATR
    bool maxOK = maxRangeATR == 0 or rangeSize <= filterATR * maxRangeATR
    bool rangeOK = minOK and maxOK and setupsToday < maxSetupsPerDay

    if rangeOK
        setupHigh   := sessionHigh
        setupLow    := sessionLow
        // Final direction uses last session bar's close
        setupIsLong := close[1] < rangeMid
        setupsToday += 1

        float finalEntry = na
        float finalInvalid = na
        float finalTgt1 = na
        float finalTgt2 = na
        float finalTgt3 = na

        if setupIsLong
            finalEntry   := setupLow + rangeSize * (gwAbove - gwBelow) / 2
            finalInvalid := setupLow - rangeSize * invalidationFib
            finalTgt1    := setupLow + rangeSize * targetStart
            finalTgt2    := setupLow + rangeSize * (targetStart + targetSpacing)
            finalTgt3    := setupLow + rangeSize * (targetStart + targetSpacing * 2)
        else
            float avgGW = (gwAbove + gwBelow) / 2
            float ref   = setupHigh + rangeSize * targetSpacing
            finalInvalid := ref + rangeSize * gwAbove
            finalEntry   := finalInvalid - rangeSize * avgGW
            finalTgt1    := finalInvalid - rangeSize * avgGW * 2
            finalTgt2    := finalInvalid - rangeSize * avgGW * 3
            finalTgt3    := finalInvalid - rangeSize * avgGW * 4

        // Update the live drawing objects to final values
        if showHighLow and not na(liveHighLine)
            line.set_y1(liveHighLine, setupHigh)
            line.set_y2(liveHighLine, setupHigh)
            line.set_y1(liveLowLine, setupLow)
            line.set_y2(liveLowLine, setupLow)
            label.set_y(liveHighLabel, setupHigh)
            label.set_text(liveHighLabel, "High: " + str.tostring(setupHigh, format.mintick))
            label.set_y(liveLowLabel, setupLow)
            label.set_text(liveLowLabel, "Low: " + str.tostring(setupLow, format.mintick))

        if showEntry and not na(liveEntryLine)
            line.set_y1(liveEntryLine, finalEntry)
            line.set_y2(liveEntryLine, finalEntry)
            label.set_y(liveEntryLabel, finalEntry)
            label.set_text(liveEntryLabel, "ENTRY " + str.tostring(finalEntry, format.mintick))

        if showInvalid and not na(liveInvalidLine)
            line.set_y1(liveInvalidLine, finalInvalid)
            line.set_y2(liveInvalidLine, finalInvalid)

        if showTargets and not na(liveTgt1Line)
            line.set_y1(liveTgt1Line, finalTgt1)
            line.set_y2(liveTgt1Line, finalTgt1)
            line.set_y1(liveTgt2Line, finalTgt2)
            line.set_y2(liveTgt2Line, finalTgt2)
            line.set_y1(liveTgt3Line, finalTgt3)
            line.set_y2(liveTgt3Line, finalTgt3)

        newSetup := true
    else
        // Range didn't qualify - delete the live drawing objects
        if not na(liveHighLine)
            line.delete(liveHighLine)
        if not na(liveLowLine)
            line.delete(liveLowLine)
        if not na(liveHighLabel)
            label.delete(liveHighLabel)
        if not na(liveLowLabel)
            label.delete(liveLowLabel)
        if not na(liveEntryLine)
            line.delete(liveEntryLine)
        if not na(liveEntryLabel)
            label.delete(liveEntryLabel)
        if not na(liveInvalidLine)
            line.delete(liveInvalidLine)
        if not na(liveInvalidLabel)
            label.delete(liveInvalidLabel)
        if not na(liveTgt1Line)
            line.delete(liveTgt1Line)
        if not na(liveTgt1Label)
            label.delete(liveTgt1Label)
        if not na(liveTgt2Line)
            line.delete(liveTgt2Line)
        if not na(liveTgt2Label)
            label.delete(liveTgt2Label)
        if not na(liveTgt3Line)
            line.delete(liveTgt3Line)
        if not na(liveTgt3Label)
            label.delete(liveTgt3Label)

    liveActive := false

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(newSetup and setupIsLong, "Long Setup Detected",
     "Xzenith LONG Setup on {{ticker}} ({{interval}}) | High: {{plot_0}} | Low: {{plot_1}}")
alertcondition(newSetup and not setupIsLong, "Short Setup Detected",
     "Xzenith SHORT Setup on {{ticker}} ({{interval}}) | High: {{plot_0}} | Low: {{plot_1}}")
alertcondition(newSetup, "Any Setup Detected",
     "Xzenith Setup on {{ticker}} ({{interval}})")

plot(setupHigh, "Setup High", display=display.none)
plot(setupLow, "Setup Low", display=display.none)
